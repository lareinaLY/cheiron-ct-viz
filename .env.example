OPENAI_API_KEY=
# Optional: override for OpenAI-compatible endpoints.
OPENAI_BASE_URL=
# Ordered provider:model list, tried in order on infrastructure failures (timeout,
# connection error, 429, 5xx). A provider without a key is skipped at startup, so one
# OpenAI key is enough. To add DeepSeek as a fallback, append it and set its key:
#   LLM_FALLBACK_CHAIN=openai:gpt-4.1-mini,deepseek:deepseek-chat
LLM_FALLBACK_CHAIN=openai:gpt-4.1-mini
# Optional: DeepSeek fallback (OpenAI-compatible API, asked in json_object mode).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# top_n used when a question asks for a ranking ("which countries have the most ...")
# without giving a number.
DEFAULT_TOP_N_FOR_RANKING=15
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
