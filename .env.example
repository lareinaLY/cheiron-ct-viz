OPENAI_API_KEY=
# Optional: override for OpenAI-compatible endpoints.
OPENAI_BASE_URL=
# Ordered provider:model list, tried in order on infrastructure failures (timeout,
# connection error, 429, 5xx). A provider without a key is skipped at startup, so one
# OpenAI key is enough. To add DeepSeek as a fallback, append it and set its key:
#   LLM_FALLBACK_CHAIN=openai:gpt-4.1-mini,deepseek:deepseek-chat
LLM_FALLBACK_CHAIN=openai:gpt-4.1-mini
# Optional: DeepSeek fallback (OpenAI-compatible API, asked in json_object mode).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# top_n used when a question asks for a ranking ("which countries have the most ...")
# without giving a number.
DEFAULT_TOP_N_FOR_RANKING=15
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
# Data quality: share of retrieved records per cohort that could not be read (structurally
# skipped). At DEGRADED_SKIP_RATIO the response is marked meta.data_quality="degraded"; at
# REFUSE_SKIP_RATIO no chart is returned (502 upstream_data_format_changed). Below
# MIN_SKIPPED_FOR_DEGRADED skipped records the result is always normal.
DEGRADED_SKIP_RATIO=0.05
REFUSE_SKIP_RATIO=0.5
MIN_SKIPPED_FOR_DEGRADED=20
# Compare GET /studies/enums with our enums at startup and log new values (never blocks).
CTVIZ_ENUM_DRIFT_CHECK=true
# Optional shared secret for a public demo: when set, POST /query requires
# "Authorization: Bearer <token>" or ?token=<token>; empty means no check.
DEMO_TOKEN=
# A /query request (planning, execution and the wait for a slot) taking longer is answered
# with 504 request_timeout.
REQUEST_DEADLINE_SECONDS=120
# /query requests executed at once; the others wait for a slot.
MAX_CONCURRENT_QUERIES=4
